# ==============================================================================
# FakeLens Deepfake Detection System - Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment.
# ==============================================================================

# Active Model Backend: "huggingface" (Vision Transformer) or "custom_pytorch" (CNN)
MODEL_BACKEND=huggingface

# Hugging Face Model Identifier (Hugging Face Hub ID or local folder path)
# Default: vishvjeet1623/image-deepfake-detection
MODEL_ID=vishvjeet1623/image-deepfake-detection

# Compute Device: "cuda" (NVIDIA GPU) or "cpu"
DEVICE=cpu

# Maximum Upload File Size in Megabytes (MB)
MAX_UPLOAD_MB=10

# Custom PyTorch Configuration (used only if MODEL_BACKEND=custom_pytorch)
CUSTOM_ARCHITECTURE=efficientnet_b0
CUSTOM_MODEL_PATH=models/model.pth

# Frontend API Configuration
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
